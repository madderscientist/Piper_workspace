<?xml version="1.0"?>
<package format="3">
  <name>piperx_cogact_client</name>
  <version>0.2.0</version>
  <description>PiPER-X local stream collector, stateless CogACT HTTP client, calibration, and MIT execution dashboard.</description>
  <maintainer email="piperx-maintainers@example.invalid">PiPER-X Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>piper_x_interfaces</exec_depend>
  <exec_depend>piper_x_driver</exec_depend>
  <exec_depend>piper_description</exec_depend>
  <exec_depend>wrist_camera</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

