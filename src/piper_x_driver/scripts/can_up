#!/usr/bin/env python3
"""Bring up the SocketCAN interfaces of the arms in $PIPER_CONFIG_DIR/arms at 1 Mbit/s."""

from pathlib import Path
import subprocess

from piper_x_driver.configuration import default_config_path, FleetConfig


def main() -> int:
    failed = False
    for arm in FleetConfig(default_config_path()).arms:
        port = arm.can_port
        flags = Path('/sys/class/net', port, 'flags')
        if not flags.is_file():
            print(f'{arm.id}: {port} not found (adapter unplugged?)')
            failed = True
            continue
        # IFF_UP: leave running interfaces untouched so active drivers are not interrupted.
        if int(flags.read_text(), 16) & 0x1:
            print(f'{arm.id}: {port} already up')
            continue
        for args in (['type', 'can', 'bitrate', '1000000'], ['up']):
            if subprocess.run(['sudo', 'ip', 'link', 'set', port, *args]).returncode:
                failed = True
                break
        else:
            print(f'{arm.id}: {port} up')
    return int(failed)


if __name__ == '__main__':
    raise SystemExit(main())
